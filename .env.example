# FinoTicket V1 — frontend environment
#
# API mode:
#   mock (default) → in-memory mockStore. Keeps the GitHub Pages demo working
#                    with no backend. Demo logins: super@fino.local,
#                    admin@ / owner@ / manager@ / agent@ / viewer@finoticket.ir
#   live           → real Laravel /api/v1. Authentication uses the OAuth2
#                    client-credentials demo client.
VITE_API_MODE=mock

# Base URL of the Laravel API (live mode only).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Demo API client used by the login page in live mode.
# These match DemoSeeder in FinoTicket-V1-Backend.
VITE_API_CLIENT_ID=ft_demo_client
VITE_API_CLIENT_SECRET=ft_demo_secret_change_me
